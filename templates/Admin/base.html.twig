<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Administration{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" type="text/css"
          href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="{{ asset('styles/app.css') }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">


</head>
<body class="bg-light-subtle">
<div class="sidebar vh-100 position-fixed overflow-y-auto shadow-sm">
    {% include 'admin/components/sidebar.html.twig' %}
</div>
<main class="main-content min-vh-100">
    {% include 'admin/components/header.html.twig'%}
    <div class="p-5 pe-0 pb-0 bg-body-tertiary">
        {% block body %}{% endblock %}
    </div>
</main>

<!-- TODO: how to add in app.js -->
<script src="https://unpkg.com/htmx.org@1.9.2"></script>
{% block javascripts %}
    {% block importmap %}
        {{ importmap('app') }}
    {% endblock %}
{% endblock %}
<script type="text/javascript"
        src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>