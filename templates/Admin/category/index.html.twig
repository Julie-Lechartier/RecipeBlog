{% extends 'base.html.twig' %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-4 pb-3">
                <a href="{{ path('app_admin_recipe_category_new') }}" type="button"
                   class="btn-border-green rounded-2 py-1 px-3 text-decoration-none"><i
                            class="bi bi-person-plus-fill text-green"></i>Ajouter une catégorie</a>
            </div>
            <div class="col-12">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th></th>
                        <th scope="col">Nom</th>
                        <th scope="col">Nombre de recette associé</th>
                        <th scope="col">Actions</th>
                    </tr>
                    </thead>
                    {% for category in categories %}
                        <tbody>
                        <tr>
                            <td><a href="{{ path('app_admin_user_show', {'slug': user.slug}) }}"><i
                                            class="bi bi-eye text-secondary"></i></a></td>
                            <td>{{ user.firstname }}</td>
                            <td>{{ user.lastname }}</td>
                            <td>{{ user.username }}</td>
                            <td>{{ user.recipes|length }}</td>
                            <td>
                                <div class="row gap-2">
                                    <a href="{{ path('app_admin_user_edit', {'slug': user.slug}) }}" class="text-decoration-none col-5 btn-full-green rounded-3 text-center py-1">
                                        <i class="bi bi-pencil-fill text-white"></i>
                                    </a>
                                    <div class=" col-5 btn-full-cherry rounded-3 text-center py-1">
                                        <a href="{{ path('app_admin_user_delete', {'slug': user.slug}) }}" class="text-decoration-none" type="submit">
                                            <i class="bi bi-trash3-fill text-white"></i>
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        </tbody>
                    {% endfor %}
                </table>
            </div>
        </div>
    </div>
{% endblock %}