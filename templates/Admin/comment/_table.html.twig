{% if pagination is defined and pagination.items is not empty %}
    <table class="table table-hover">
        <thead>
        <tr>
            <th scope="col">Auteur</th>
            <th scope="col">Recette associée</th>
            <th scope="col">Commentaire</th>
            <th scope="col">Date de création</th>
            <th scope="col">Actions</th>
        </tr>
        </thead>
        {% for comment in pagination.items %}
            <tbody>
            <tr>
                <td>{{ comment.user.username }}</td>
                <th>{{ comment.recipe.title }}</th>
                <td>{{ comment.content }}</td>
                <td>{{ comment.createdAt|date("d/m/Y") }}</td>
                <td>
                    <div class="row gap-2">
                        <a href="{{ path('app_admin_comment_delete', {'slug': comment.slug}) }}"
                           class="text-decoration-none  col-5 btn-full-cherry rounded-3 text-center py-1 btn-table-size"
                           type="submit">
                            <i class="bi bi-trash3-fill text-white"></i>
                        </a>
                    </div>
                </td>
            </tr>
            </tbody>
        {% endfor %}
    </table>
    <div class="mt-3">
        {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig') }}
    </div>
{% else %}
    <p>Aucune recette disponible.</p>
{% endif %}
