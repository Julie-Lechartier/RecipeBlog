{% extends "admin/base.html.twig" %}

{% block body %}
    <div class="container-fluid bg-white mt-2">
        <div class="row pt-5 ps-4">
            <div class="col-4 pb-3">
                <a href="{{ path('app_admin_comment_new') }}" type="button"
                   class="btn-border-green rounded-2 py-1 px-3 text-decoration-none">
                    <i class="bi bi-person-plus-fill text-green"></i>
                    Ajouter un commentaire
                </a>
            </div>
            <div class="col-12">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th></th>
                        <th scope="col">Auteur</th>
                        <th scope="col">Recette associée</th>
                        <th scope="col">Commentaire</th>
                        <th scope="col">Date de création</th>
                        <th scope="col">Actions</th>
                    </tr>
                    </thead>
                    {% for comment in comments %}
                        <tbody>
                        <tr>
                            <td><a href="{{ path('app_admin_user_show', {'slug': user.slug}) }}"><i
                                            class="bi bi-eye text-secondary"></i></a></td>
                            <td>{{ user.firstname }}</td>
                            <td>{{ user.lastname }}</td>
                            <td>{{ user.username }}</td>
                            <td>{{ user.recipes|length }}</td>
                            <td>
                                <div class="row gap-2">
                                    <a href="{{ path('app_admin_user_delete', {'slug': user.slug}) }}"
                                       class="text-decoration-none  col-5 btn-full-cherry rounded-3 text-center py-1 btn-table-size"
                                       type="submit">
                                        <i class="bi bi-trash3-fill text-white"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        </tbody>
                    {% endfor %}
                </table>
            </div>
        </div>
    </div>
    </div>
{% endblock body %}

