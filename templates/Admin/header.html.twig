<script>
    document.getElementById('btn-switch').addEventListener('click',()=>{
        if (document.documentElement.getAttribute('data-bs-theme') == 'dark') {
            document.documentElement.setAttribute('data-bs-theme','light')
            document.getElementById('switch-icon').className = "bi bi-brightness-high";
            document.getElementById('btn-switch').className = "btn btn-light shadow me-3 rounded-circle"
        }
        else {
            document.documentElement.setAttribute('data-bs-theme','dark')
            document.getElementById('switch-icon').className = "bi bi-moon";
            document.getElementById('btn-switch').className = "btn btn-dark shadow me-3 rounded-circle"

        }
    })
</script>