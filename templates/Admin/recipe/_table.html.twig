{% if pagination is defined and pagination.items is not empty %}
    <table class="table table-hover">
        <thead>
        <tr>
            <th scope="col" class="col-3">Titre</th>
            <th scope="col" class="col-3">Type</th>
            <th scope="col" class="col-3">Auteur</th>
            <th scope="col" class="col-3">Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for recipe in pagination.items %}
            <tr>
                <th scope="row">{{ recipe.title }}</th>
                <td>
                    {% if recipe.category is empty %}
                        <span>Aucune catégorie</span>
                    {% else %}
                        {% for category in recipe.category %}
                            <span>{{ category.name }}</span>
                        {% endfor %}
                    {% endif %}
                </td>
                <td>{{ recipe.author.username }}</td>
                <td>
                    <div class="d-flex gap-2">
                        <a href="{{ path('app_admin_recipe_edit', {'slug': recipe.slug}) }}"
                           class="text-decoration-none  btn-full-green rounded-3 text-center py-1 actions-table-custom">
                            <i class="bi bi-pencil-fill text-white"></i>
                        </a>
                        <a href="{{ path('app_admin_comment_new') }}"
                           class="text-decoration-none btn-full-brown rounded-3 text-center py-1 actions-table-custom">
                            <i class="bi bi-chat-fill text-white"></i>
                        </a>
                        <a href="{{ path('app_admin_recipe_delete', {'slug': recipe.slug}) }}"
                           class="text-decoration-none  btn-full-cherry rounded-3 text-center py-1 actions-table-custom">
                            <i class="bi bi-trash3-fill text-white"></i>
                        </a>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="mt-3">
        {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig') }}
    </div>
{% else %}
    <p>Aucune recette disponible.</p>
{% endif %}