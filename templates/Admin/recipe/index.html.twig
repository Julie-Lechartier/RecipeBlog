{% extends "admin/base.html.twig" %}
{% block body %}
    <div class="container-fluid bg-white mt-2 px-5">
        <div class="row mb-4 pt-4">
            <div class="col-md-8">
                <h2 class="fw-bold mb-0">Gestion des recettes</h2>
                <p class="text-muted">Gérez toutes les recettes de la plateforme</p>
            </div>
            <div class="col-md-4 text-end">
                <a href="{{ path('app_admin_recipe_new') }}" type="button"
                   class="btn btn-full-green text-white rounded-pill py-2 px-4 shadow-sm">
                    <i class="bi bi-plus-circle me-2"></i>
                    Ajouter une recette
                </a>
            </div>
        </div>

        <div class="row">
            <!-- TODO: change filter -->
            <div class="col-md-4">
                <label for="search" class="form-label small text-muted">Rechercher une recette</label>
                <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                    <input type="text" id="search" name="search" class="form-control border-start-0"
                           placeholder="Nom, ingrédients, auteur..."
                           hx-post="{{ path('app_recipe_table_filter') }}"
                           hx-target="#table-container"
                           hx-trigger="keyup changed delay:500ms"
                           hx-indicator=".htmx-indicator"
                           hx-include="[name='page']">
                </div>
            </div>
            <div class="col-md-2">
                <label for="category" class="form-label small text-muted">Filtrer par catégorie</label>
                <select id="category" name="category" class="form-select"
                        hx-post="{{ path('app_recipe_table_filter') }}"
                        hx-target="#table-container"
                        hx-trigger="change"
                        hx-include="[name='page']">
                    <option value="">Toutes les catégories</option>
                    {% for cat in categories %}
                        <option value="{{ cat.id }}">{{ cat.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <input type="hidden" name="page" value="{{ pagination.currentPageNumber|default(1) }}">

            <span class="htmx-indicator">Chargement...</span>
        </div>

        <div class="col-12" id="table-container">
            {% include 'admin/recipe/_table.html.twig' with {'pagination': pagination} %}
        </div>
    </div>

    <script>
        document.addEventListener('htmx:afterSwap', function (event) {
            const paginationLinks = document.querySelectorAll('.pagination a');
            paginationLinks.forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const page = new URLSearchParams(this.getAttribute('href')).get('page') || 1;
                    document.querySelector('input[name="page"]').value = page;
                    htmx.trigger('input[name="search"]', 'change');
                });
            });
        });
    </script>
{% endblock %}