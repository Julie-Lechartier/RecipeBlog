{% extends "admin/base.html.twig" %}
{% block body %}
    <div class="container-fluid bg-white mt-2">
        <div class="row pt-5 ps-4">
            <div class="col-3 pb-3">
                <a href="{{ path('app_admin_recipe_new') }}" type="button"
                   class="btn-border-green rounded-2 py-1 px-3 text-decoration-none">
                    <i class="bi bi-plus text-green"></i>
                    Ajouter une recette
                </a>
            </div>
            <div class="col-12">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th scope="col">Titre</th>
                        <th scope="col">Type</th>
                        <th scope="col">Auteur</th>
                        <th scope="col">Actions</th>
                    </tr>
                    </thead>
                    {% for recipe in recipes %}
                        <tbody>
                        <tr>
                            <th scope="row">{{ recipe.title }}</th>
                            <td>
                                {% for category in recipe.category %}
                                    <span class="">{{ category.name }}</span>
                                {% endfor %}
                            </td>
                            <td>{{ recipe.author.username }}</td>
                            <td>
                                <div class="d-flex">
                                    <a href="{{ path('app_admin_recipe_edit', {'slug': recipe.slug}) }}"
                                       class="text-decoration-none col-5 btn-full-green rounded-3 text-center py-1">
                                        <i class="bi bi-pencil-fill text-white"></i>
                                    </a>
                                    <a href="{{ path('app_admin_recipe_delete', {'slug': recipe.slug}) }}"
                                       class="text-decoration-none col-5 btn-full-cherry rounded-3 text-center py-1">
                                        <i class="bi bi-trash3-fill text-white"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        </tbody>
                    {% endfor %}
                </table>
            </div>
        </div>
    </div>
{% endblock %}