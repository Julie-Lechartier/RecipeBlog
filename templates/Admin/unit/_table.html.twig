{% if pagination is defined and pagination.items is not empty %}
    <table class="table table-hover">
        <thead>
        <tr>
            <th scope="col">Nom</th>
            <th scope="col">Recette associée</th>
            <th scope="col">Actions</th>
        </tr>
        </thead>
        {% for unit in pagination.items %}
            <tbody>
            <tr>
                <td>{{ unit.name }}</td>
                <td></td>
                <td>
                    <div class="row gap-2">
                        <a href="{{ path('app_admin_unit_edit', {'slug': unit.slug}) }}"
                           class="text-decoration-none  btn-full-green rounded-3 text-center py-1 actions-table-custom">
                            <i class="bi bi-pencil-fill text-white"></i>
                        </a>
                        <a href="{{ path('app_admin_unit_delete', {'slug' : unit.slug}) }}"
                           class="text-decoration-none  col-5 btn-full-cherry rounded-3 text-center py-1 btn-table-size"
                           type="submit">
                            <i class="bi bi-trash3-fill text-white"></i>
                        </a>

                    </div>
                </td>
            </tr>
            </tbody>
        {% endfor %}
    </table>
    <div class="mt-3">
        {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig') }}
    </div>
{% else %}
    <p>Aucun ingredient disponible.</p>
{% endif %}


