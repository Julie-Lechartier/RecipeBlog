{% if pagination is defined and pagination.items is not empty %}
    <div class="pb-5 vh-100">
        <table class="table table-hover">
            <thead>
            <tr>
                <th scope="col" class="col-5">Nom</th>
                <th scope="col" class="col-3">Recettes associées</th>
                <th scope="col" class="col-4">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for unit in pagination.items %}
                <tr>
                    <td>{{ unit.name }}</td>
                    <td>
                        {% if unit.recipeIngredients is defined %}
                            {{ unit.recipeIngredients|length }}
                        {% else %}
                            0
                        {% endif %}
                    </td>
                    <td>
                        <div class="d-flex gap-2 pe-3">
                            <a href="{{ path('app_admin_unit_edit', {'slug': unit.slug}) }}"
                               class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal{{ unit.slug|replace({'-': ''}) }}">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                <!-- Modal de confirmation de suppression -->
                <div class="modal fade" id="deleteModal{{ unit.slug|replace({'-': ''}) }}" tabindex="-1"
                     aria-labelledby="deleteModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="deleteModalLabel">Confirmer la suppression</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                Êtes-vous sûr de vouloir supprimer l'unité "{{ unit.name }}" ?
                                {% if unit.recipeIngredients is defined and unit.recipeIngredients|length > 0 %}
                                    <div class="alert alert-warning mt-2">
                                        Attention : Cette unité est utilisée dans {{ unit.recipeIngredients|length }}
                                        recette(s).
                                    </div>
                                {% endif %}
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                <a href="{{ path('app_admin_unit_delete', {'slug': unit.slug}) }}"
                                   class="btn btn-danger">Supprimer</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
            </tbody>
        </table>
        <div class="mt-3">
            {{ knp_pagination_render(pagination, 'Admin/components/pagination.html.twig') }}
        </div>
    </div>
{% else %}
    <div class="vh-100 d-flex justify-content-center">
        <p>Aucune unité disponible.</p>
    </div>
{% endif %}