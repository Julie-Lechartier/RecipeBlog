{{ form_start(form, {'action': path('app_admin_user_new'), 'method': 'POST'}) }}

<div class="container ">
    <div class="row">
        <div class="mb-3">
            <label for="InputFirstname" class="form-label">{{ form_label(form.firstname) }}</label>
            {{ form_widget(form.firstname) }}
        </div>
        <div class="mb-3">
            <label for="inputLastname" class="form-label">{{ form_label(form.lastname) }}</label>
            {{ form_widget(form.lastname) }}
        </div>
        <div class="mb-3">
            <label for="inputUsername" class="form-label">{{ form_label(form.username) }}</label>
            {{ form_widget(form.username) }}
        </div>
        <div class="mb-3">
            <label for="inputEmail" class="form-label">{{ form_label(form.email) }}</label>
            {{ form_widget(form.email) }}

        </div>
        <div class="mb-3">
            <label for="inputBirthDate" class="form-label">{{ form_label(form.birthDate) }}</label>
            {{ form_widget(form.birthDate) }}

        </div>
        <div class="mb-3">
            <label for="InputPassword1" class="form-label">{{ form_label(form.password) }}</label>
            {{ form_widget(form.password) }}
        </div>
        <div class="mb-3 form-check">
            <label class="form-check-label" for="exampleCheck1">{{ form_label(form.newsletter) }}</label>
            {{ form_widget(form.newsletter) }}
        </div>
        <button type="submit" class="btn btn-primary" href="{{ path('app_admin_user_index') }}">Submit</button>
    </div>
</div>


{{ form_end(form) }}