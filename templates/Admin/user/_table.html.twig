{% if pagination is defined and pagination.items is not empty %}
    <table class="table table-hover">
        <thead>
        <tr>
            <th scope="col" class="col-2">Prénom</th>
            <th scope="col" class="col-2">Nom</th>
            <th scope="col" class="col-2">Pseudo</th>
            <th scope="col" class="col-2">Recettes</th>
            <th scope="col" class="col-4">Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for user in pagination.items %}
            <tr>
                <td>{{ user.firstname }}</td>
                <td>{{ user.lastname }}</td>
                <td>{{ user.username }}</td>
                <td>{{ user.recipes|length }}</td>
                <td>
                    <div class="d-flex gap-2 pe-3">
                        <a href="{{ path('app_admin_user_show', {'slug': user.slug}) }}"
                           class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a href="{{ path('app_admin_user_edit', {'slug': user.slug}) }}"
                           class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <button type="button"
                                class="btn-border-cherry rounded-pill px-3 py-2"
                                data-bs-toggle="modal" data-bs-target="#deleteModal{{ user.slug|replace({'-': ''}) }}">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                </td>
            </tr>
            <div class="modal fade" id="deleteModal{{ user.slug|replace({'-': ''}) }}" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="deleteModalLabel">Confirmer la suppression</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            Êtes-vous sûr de vouloir supprimer l'utilisateur {{ user.firstname }} {{ user.lastname }} ?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                            <a href="{{ path('app_admin_user_delete', {'slug': user.slug}) }}" class="btn btn-danger">Supprimer</a>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
        </tbody>
    </table>
    <div class="mt-3">
        {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig') }}
    </div>
{% else %}
    <p>Aucun utilisateur disponible.</p>
{% endif %}