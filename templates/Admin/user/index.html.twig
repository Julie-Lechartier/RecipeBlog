{% extends "admin/base.html.twig" %}

{% block body %}
    <div class="container-fluid bg-white mt-2">
        <div class="row pt-5 ps-4">
            <div class="col-4 pb-3">
                <a href="{{ path('app_admin_user_new') }}" type="button"
                   class="btn-border-green rounded-2 py-1 px-3 text-decoration-none">
                    <i class="bi bi-person-plus-fill text-green"></i>
                    Ajouter un utilisateur
                </a>
            </div>
            <div class="col-12">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th></th>
                        <th scope="col">Prénom</th>
                        <th scope="col">Nom</th>
                        <th scope="col">Pseudo</th>
                        <th scope="col">Recette</th>
                        <th scope="col">Actions</th>
                    </tr>
                    </thead>
                    {% for user in users %}
                        <tbody>
                        <tr>
                            <td><a href="{{ path('app_admin_user_show', {'slug': user.slug}) }}"><i
                                            class="bi bi-eye text-secondary"></i></a></td>
                            <td>{{ user.firstname }}</td>
                            <td>{{ user.lastname }}</td>
                            <td>{{ user.username }}</td>
                            <td>{{ user.recipes|length }}</td>
                            <td>
                                <div class="row gap-2">
                                    <a href="{{ path('app_admin_user_edit', {'slug': user.slug}) }}"
                                       class="text-decoration-none col-5 btn-full-green rounded-3 text-center py-1 btn-table-size">
                                        <i class="bi bi-pencil-fill text-white"></i>
                                    </a>
                                    <a href="{{ path('app_admin_user_delete', {'slug': user.slug}) }}"
                                       class="text-decoration-none  col-5 btn-full-cherry rounded-3 text-center py-1 btn-table-size"
                                       type="submit">
                                        <i class="bi bi-trash3-fill text-white"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        </tbody>
                    {% endfor %}
                </table>
                <nav aria-label="Page navigation example">
                    <ul class="pagination">
                        <li class="page-item">
                            <a class="page-link" href="#" aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                        <li class="page-item"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item">
                            <a class="page-link" href="#" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
{% endblock body %}

