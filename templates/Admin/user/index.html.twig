{% extends "admin/base.html.twig" %}
{% block body %}
    <div class="container-fluid bg-white mt-2 px-5 mh-100">
        <div class="row mb-4 pt-4">
            <div class="col-md-8">
                <h2 class="fw-bold mb-0">Gestion des utilisateurs</h2>
                <p class="text-muted">Gérez tous les utilisateurs de la plateforme</p>
            </div>
            <div class="col-md-4 text-end">
                <a href="{{ path('app_admin_user_new') }}" type="button"
                   class="btn btn-full-green text-white rounded-pill py-2 px-4 shadow-sm text-nowrap">
                    <i class="bi bi-person-plus-fill me-2"></i>
                    Ajouter un utilisateur
                </a>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12">
                <label class="form-label small text-muted mb-3">Rechercher un utilisateur</label>
                <div class="row g-3">
                    <div class="col-md-3">
                        <input type="text"
                               id="firstname"
                               name="firstname"
                               class="form-control"
                               placeholder="Prénom"
                               hx-post="{{ path('app_admin_user_table_filter') }}"
                               hx-target="#table-container"
                               hx-indicator=".htmx-indicator"
                               hx-include="[name='page']"
                               hx-trigger="keyup changed delay:500ms">
                    </div>
                    <div class="col-md-3">
                        <input type="text"
                               id="lastname"
                               name="lastname"
                               class="form-control"
                               placeholder="Nom"
                               hx-post="{{ path('app_admin_user_table_filter') }}"
                               hx-target="#table-container"
                               hx-indicator=".htmx-indicator"
                               hx-include="[name='page']"
                               hx-trigger="keyup changed delay:500ms">
                    </div>
                    <div class="col-md-3">
                        <input type="text"
                               id="username"
                               name="username"
                               class="form-control"
                               placeholder="Pseudo"
                               hx-post="{{ path('app_admin_user_table_filter') }}"
                               hx-target="#table-container"
                               hx-indicator=".htmx-indicator"
                               hx-include="[name='page']"
                               hx-trigger="keyup changed delay:500ms">
                    </div>
                </div>
            </div>
        </div>

        <input type="hidden" name="page" value="{{ pagination.currentPageNumber|default(1) }}">

        <div class="htmx-indicator d-flex justify-content-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
        </div>

        <div class="col-12" id="table-container">
            {% include 'admin/user/_table.html.twig' with {'pagination': pagination} %}
        </div>
    </div>

    <script>
        document.addEventListener('htmx:afterSwap', function (event) {
            const paginationLinks = document.querySelectorAll('.pagination a');
            paginationLinks.forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const page = new URLSearchParams(this.getAttribute('href')).get('page') || 1;
                    document.querySelector('input[name="page"]').value = page;
                    htmx.trigger('input[name="search"]', 'change');
                });
            });
        });
    </script>
{% endblock %}