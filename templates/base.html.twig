<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
{{ render(path('app_navigation', { 'currentPageRoute': app.request.attributes.get('_route') })) }}
{% block body %}

            {% include 'components/hero.html.twig' %}

    <div class="position-relative">
        <div class="position-sticky btn-full-green top-50 z-3">
            <a href="{{ path('app_new_recipe') }}" class="btn btn-primary">
                <i class="bi bi-plus text-white"></i>
            </a>
        </div>
    </div>
{% endblock %}


{% block javascripts %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
{% endblock %}


</body>
</html>
