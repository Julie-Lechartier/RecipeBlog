<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}MaMeilleureRecette{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.rtl.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>

</head>
<body>

{{ render(path('app_navigation', { 'currentPageRoute': app.request.attributes.get('_route') })) }}
{% block body %}
{% endblock %}

<!-- New recipe button -->
{% if app.user and app.request.get('_route') not in ['app_user_profile', 'app_new_recipe', 'app_recipe_edit'] %}
    <div class="position-fixed bottom-0 end-0 me-4 mb-4 z-3">
        <a href="{{ path('app_new_recipe') }}"
           class="btn btn-full-green btn-new-recipe rounded-circle d-flex justify-content-center align-items-center ps-4"
           style="width: 56px; height: 56px;">
            <span class="button-icon"><i class="bi bi-plus fs-3 text-white"></i></span>
            <span class="button-text text-white fw-lighter">Créer une recette</span>
        </a>
    </div>
{% endif %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
 <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<!-- Initialize components -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var dropdownElementList = document.querySelectorAll('.dropdown-toggle');
        dropdownElementList.forEach(function(element) {
            new bootstrap.Dropdown(element);
        });
        $(document).ready(function() {
            $('.select2-element').select2({
                theme: 'bootstrap-5'
            });
        });
    });
</script>

{% block javascripts %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
{% endblock %}
</body>
</html>