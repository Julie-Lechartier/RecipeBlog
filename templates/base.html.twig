{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Recipe{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    {% block stylesheets %}{% endblock %}
</head>
<body>
{{ render(path('app_navigation', { 'currentPageRoute': app.request.attributes.get('_route') })) }}
{% block body %}{% endblock %}

<!-- New recipe button -->
{% if app.user and app.request.get('_route') not in ['app_user_profile', 'app_new_recipe', 'app_recipe_edit'] %}
    <div class="position-fixed bottom-0 end-0 me-4 mb-4 z-3">
        <a href="{{ path('app_new_recipe') }}"
           class="btn btn-new-recipe btn-full-green rounded-pill d-flex align-items-center ps-4"
           style="height: 56px;">
            <span class="button-icon"><i class="bi bi-plus fs-3 text-white"></i></span>
            <span class="button-text text-white fw-medium">Créer une recette</span>
        </a>
    </div>
{% endif %}

{% block javascripts %}
    {{ importmap('app') }}
{% endblock %}
</body>
</html>