<form hx-post="{{ path('app_comment_edit', {'id': comment.id}) }}"
      hx-target="#comment-content-{{ comment.id }}"
      hx-swap="innerHTML">
    {{ form_widget(form.content, {'attr': {'class': 'form-control', 'rows': 3}}) }}
    {{ form_rest(form) }}

    <div class="d-flex justify-content-end mt-3">
        <button type="button"
                class="btn btn-sm btn-outline-secondary me-2"
                hx-get="{{ path('app_comment_content', {'id': comment.id}) }}"
                hx-target="#comment-content-{{ comment.id }}"
                hx-swap="innerHTML">
            Annuler
        </button>
        <button type="submit" class="btn btn-sm btn-primary">
            Enregistrer
        </button>
    </div>
</form>