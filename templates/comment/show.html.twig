<div class="col-12 mb-4">
    <h2 class="h3">
        <i class="bi bi-chat-left-text me-2 text-dark-green"></i>Commentaires
    </h2>
</div>
{% if comments|length > 0 %}
    <div class="col-12 mb-4">
        {% for comment in comments %}
            <div class="card border-0 shadow-sm mb-3 w-100" id="comment-{{ comment.id }}">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <div class="d-flex align-items-center">
                        <span class="fw-medium">{{ comment.user.username }}</span>
                    </div>
                    <small class="text-muted">{{ comment.createdAt|date("d/m/Y à H:i") }}</small>
                </div>
                <!-- Content - Cette div est cruciale pour HTMX -->
                <div class="card-body" id="comment-content-{{ comment.id }}">
                    <p class="card-text mb-0">{{ comment.content }}</p>
                </div>
                {% if app.user and (app.user == comment.user) %}
                    <div class="card-footer bg-white text-end border-0 py-2">
                        <button hx-get="{{ path('app_comment_edit', {'id': comment.id}) }}"
                                hx-target="#comment-content-{{ comment.id }}"
                                hx-swap="innerHTML"
                                class="btn btn-sm btn-outline-secondary me-2">
                            <i class="bi bi-pencil-square me-1"></i>Modifier
                        </button>
                        <a href="{{ path('app_comment_delete', {'id': comment.id}) }}"
                           class="btn btn-sm btn-outline-danger"
                           onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce commentaire?')">
                            <i class="bi bi-trash me-1"></i>Supprimer
                        </a>
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="col-12 mb-4 text-center">
        <div class="py-4">
            <i class="bi bi-chat-square-text text-secondary" style="font-size: 2rem;"></i>
            <p class="mt-3 text-secondary">Aucun commentaire pour cette recette.</p>
        </div>
    </div>
{% endif %}
{% if app.user %}
    <div class="col-12">
        <div class="card border-0 shadow-sm w-100">
            <div class="card-header bg-white">
                <h3 class="h5 mb-0">
                    <i class="bi bi-pencil me-2 text-dark-green"></i>Ajouter un commentaire
                </h3>
            </div>
            <div class="card-body">
                {{ render(path('app_comment_new', {'recipeSlug': recipe.slug})) }}
            </div>
        </div>
    </div>
{% else %}
    <div class="col-12 text-center py-3">
        <p class="mb-2">Connectez-vous pour laisser un commentaire</p>
        <a href="{{ path('app_login') }}" class="btn btn-outline-success">
            <i class="bi bi-box-arrow-in-right me-1"></i>Connexion
        </a>
    </div>
{% endif %}