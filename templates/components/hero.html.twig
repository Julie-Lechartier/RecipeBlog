<section class="hero-section position-relative shadow-sm">
    <div class="hero-bg" style="">
        {% for media in banner.media %}
            <img src="{{ asset('uploads/banners/' ~ media.fileName) }}" alt="Image">
        {% endfor %}
        <div class="container">
            <div class="row min-vh-75 align-items-center">
                <div class="col-lg-7 text-center text-lg-start py-5">
                    <h1 class="display-4 fw-bold mb-3">{{ banner.title }}</h1>
                    <p class="lead mb-4">{{ banner.description }}</p>
                    <div class="d-flex flex-column flex-sm-row gap-3">
                        <a href="{{ banner.link }}"
                           class="btn btn-full-green btn-lg px-4 rounded-pill fw-bold">{{ banner.buttonText }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>