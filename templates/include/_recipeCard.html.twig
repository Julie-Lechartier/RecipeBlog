<div class="row g-4">
    {% for recipe in recipes %}
        <div class="col-12 col-md-6 col-lg-4">
            <div class="h-100 border-0 shadow-sm recipe-card">
                <div class="position-relative">
                    {% if recipe.media|length > 0 %}
                        <img src="{{ recipe.media[0].url }}"
                             class="card-img-top"
                             alt="{{ recipe.title }}"
                             style="height: 200px; object-fit: cover;">
                    {% endif %}
                    <div class="recipe-overlay">
                        <span class="badge bg-success position-absolute top-0 end-0 m-2">
                            <i class="bi bi-clock"></i> {{ recipe.preparationTime|date('H:i') }}
                        </span>
                    </div>
                </div>
                <div class="d-flex flex-column py-3 px-3">
                    <div class="flex-grow-1">
                        <h5 class="mb-3">
                            <a href="{{ path('app_recipe_show', {'slug': recipe.slug}) }}"
                               class="text-decoration-none text-dark stretched-link">
                                {{ recipe.title }}
                            </a>
                        </h5>
                        <p class="text-muted">
                            {{ recipe.description|striptags|slice(0, 100) }}...
                        </p>
                    </div>
                    <div class="recipe-footer mt-auto pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="recipe-meta">
                                <span class="text-muted">
                                    <i class="bi bi-people"></i> {{ recipe.serving }}
                                </span>
                            </div>
                            <div class="author">
                                <small class="text-muted">
                                    Par {{ recipe.author.firstname }} {{ recipe.author.lastname }}
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
</div>

<style>
    .recipe-card {
        transition: transform 0.2s ease-in-out;
        border-radius: 12px;
        overflow: hidden;
    }

    .recipe-card:hover {
        transform: translateY(-5px);
    }

    .recipe-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(
                180deg,
                rgba(0,0,0,0.2) 0%,
                rgba(0,0,0,0) 40%
        );
    }

    .card-title {
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.4;
    }

    .card-text {
        font-size: 0.9rem;
        line-height: 1.6;
    }

    .recipe-meta {
        font-size: 0.9rem;
    }

    .author {
        font-size: 0.85rem;
    }

    .recipe-footer {
        margin-top: auto;
        border-color: rgba(0,0,0,0.1) !important;
    }

    @media (max-width: 768px) {
        .recipe-card {
            margin-bottom: 1rem;
        }
    }
</style>