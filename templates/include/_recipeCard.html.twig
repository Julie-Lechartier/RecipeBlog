<div class="row g-4">
    {% for recipe in recipes %}
        <div class="col-12 col-md-6 col-lg-4">
            <div class="h-100 border-0 shadow-sm recipe-card">
                <div class="position-relative">

                    {% if recipe.media|length > 0 %}
                        <img src="{{ recipe.media[0].url }}"
                             class="card-img-top"
                             alt="{{ recipe.title }}"
                             style="height: 200px; object-fit: cover;">
                    {% endif %}
                    <div class="recipe-overlay">
                        <span class="badge bg-success position-absolute top-0 end-0 m-2">
                            <i class="bi bi-clock"></i> {{ recipe.preparationTime|date('H:i') }}
                        </span>
                    </div>
                </div>
                <div class="d-flex flex-column py-3 px-3">
                    <div class="flex-grow-1">
                        <h5 class="mb-3">
                            <a href="{{ path('app_recipe_show', {'slug': recipe.slug}) }}"
                               class="text-decoration-none text-dark stretched-link">
                                {{ recipe.title }}
                            </a>
                        </h5>
                        <p class="text-muted">
                            {{ recipe.description|striptags|slice(0, 100) }}...
                        </p>
                    </div>
                    <div class="recipe-footer mt-auto pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="recipe-meta">
                                <span class="text-muted">
                                    <i class="bi bi-people"></i> {{ recipe.serving }}
                                </span>
                            </div>
                            <div class="author">
                                <small class="text-muted">
                                    Par {{ recipe.author.firstname }} {{ recipe.author.lastname }}
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
</div>