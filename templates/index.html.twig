{% extends 'base.html.twig' %}
{% block body %}

    {% include 'components/hero.html.twig' %}
    <div class="container">
        <!-- Mobile Search bar Start -->
        <div class="d-lg-none d-block py-4 px-5">
            <div class="search-bar">
                <div class="input-group ">
                    <input type="text" class="form-control bg-secondary-subtle" placeholder="Rechercher"
                           aria-label="Search" aria-describedby="search-addon">
                    <button class="btn btn-outline-secondary bg-secondary-subtle border-0" type="button"
                            id="search-addon">
                        <i class="bi bi-search text-secondary"></i>
                    </button>
                </div>
            </div>
        </div>
        <!-- Mobile Search bar End -->
    </div>
    <!-- Scroll container sample for Recipe of the day -->
    <div class="container-fluid p-0">
        <div class="d-flex justify-content-between px-3 align-items-end">
            <h2 class="fw-bold">Recette du jour</h2>
            <a href="{{ path('app_recipe_index') }}" class="text-black">Tout voir</a>
        </div>
        <div class="container-fluid pe-0">
            <!-- Card -->
            {{ render(path('app_include_recipe_scroll', {'limit': 10})) }}
        </div>
    </div>
    <!-- Scroll container sample for Recipe dish -->
    <div class="container m-0 w-100 mw-100 p-0">
        <h2 class="fw-bold">Plats</h2>
        <div class="container-fluid pe-0">
            <!-- Card -->
            {{ render(path('app_include_recipe_scroll', {'category': 'Plats','limit': 10})) }}
        </div>
    </div>
    <!-- Scroll container sample for Recipe dessert -->
    <div class="container m-0 w-100 mw-100 p-0">
        <h2 class="fw-bold">Dessert</h2>
        <div class="container-fluid pe-0">
            <!-- Card -->
            {{ render(path('app_include_recipe_scroll', {'category': 'Dessert','limit': 10})) }}
        </div>
    </div>
{% endblock %}