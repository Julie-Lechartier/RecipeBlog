{% extends 'base.html.twig' %}

{% block body %}
    {% if banner.isActive %}
        {% include 'components/hero.html.twig' %}
    {% endif %}
    <div class="container py-4">
        <!-- Mobile Search bar -->
        <div class="d-lg-none mb-4">
            <div class="search-bar rounded-pill overflow-hidden shadow-sm">
                <div class="input-group">
                    <input type="text" class="form-control border-0 py-2" placeholder="Rechercher une recette..."
                           aria-label="Search" aria-describedby="search-addon">
                    <button class="btn btn-primary px-3" type="button" id="search-addon">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </div>
        <!-- Introduction -->
        <section class="intro-section py-5 bg-light">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-8 text-center">
                        <h2 class="fw-bold mb-3">Une communauté de passionnés de cuisine</h2>
                        <p class="lead mb-4">Partagez vos recettes préférées, découvrez les créations d'autres cuisiniers amateurs et échangez vos astuces culinaires.</p>
                        <div class="row g-4 mt-3">
                            <div class="col-md-4">
                                <div class="d-flex align-items-center justify-content-center mb-2">
                                    <i class="bi bi-upload fs-1 text-green"></i>
                                </div>
                                <h5 class="fw-bold">Partagez</h5>
                                <p>Publiez facilement vos meilleures recettes et photos</p>
                            </div>
                            <div class="col-md-4">
                                <div class="d-flex align-items-center justify-content-center mb-2">
                                    <i class="bi bi-search fs-1 text-green"></i>
                                </div>
                                <h5 class="fw-bold">Découvrez</h5>
                                <p>Trouvez de l'inspiration parmi des centaines de recettes</p>
                            </div>
                            <div class="col-md-4">
                                <div class="d-flex align-items-center justify-content-center mb-2">
                                    <i class="bi bi-chat-dots fs-1 text-green"></i>
                                </div>
                                <h5 class="fw-bold">Échangez</h5>
                                <p>Commentez et partagez vos astuces culinaires</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Recette du jour Section -->
        <section class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="fw-bold position-relative">
                    Recette du jour
                </h2>
                <a href="{{ path('app_recipe_index') }}"
                   class="text-decoration-none d-flex align-items-center text-black">
                    Tout voir <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="recipe-scroll">
                {{ render(path('app_include_recipe_scroll', {'limit': 10})) }}
            </div>
        </section>

        <!-- Plats Section -->
        <section class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="fw-bold position-relative">
                    Plats
                </h2>
                <a href="{{ path('app_recipe_category_show', {'category' : 'plats'}) }}"
                   class="text-decoration-none d-flex align-items-center text-black">
                    Tout voir <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="recipe-scroll">
                {{ render(path('app_include_recipe_scroll', {'category': 'Plats','limit': 10})) }}
            </div>
        </section>

        <!-- Dessert Section -->
        <section class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="fw-bold position-relative">
                    Desserts
                </h2>
                <a href="{{ path('app_recipe_category_show', {'category' : 'desserts'}) }}"
                   class="text-decoration-none d-flex align-items-center text-black">
                    Tout voir <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="recipe-scroll">
                {{ render(path('app_include_recipe_scroll', {'category': 'Dessert','limit': 10})) }}
            </div>
        </section>
        <!-- TODO: 'nos cuisinier les plus actifs, recettes populaires'-->
    </div>
{% endblock %}