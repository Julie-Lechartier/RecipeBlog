{{ form_start(form) }}
<div class="container">
    <div class="row mx-5 pt-5">
        <div class="mt-5"></div>
        <h2>Création de la recette : <span id="recipeTitlePreview"></span></h2>
    </div>
    <div class="row mx-5 justify-content-center">
        <div class="mb-3 col-12">
            <label for="inputTitle" class="form-label">{{ form_label(form.title) }}</label>
            {{ form_widget(form.title) }}
        </div>
        <div class="mb-3 col-12">
            <label for="InputCategory" class="form-label">{{ form_label((form.category)) }}</label>
            {{ form_widget(form.category) }}
        </div>

        <div class="mb-3 col-6">
            <label for="inputPreparationTime" class="form-label ">{{ form_label(form.preparationTime) }}</label>
            {{ form_widget(form.preparationTime) }}
        </div>
        <div class="mb-3 col-6">
            <label for="InputServing" class="form-label text-nowrap">{{ form_label((form.serving)) }}</label>
            {{ form_widget(form.serving) }}
        </div>
        <div class="mb-3 col-12">
            <label for="inputDescription" class="form-label">{{ form_label(form.description) }}</label>
            {{ form_widget(form.description) }}
        </div>

        <div class="mb-3 col-12">
            <label for="inputImage" class="form-label">{{ form_label(form.image) }}</label>
            {{ form_widget(form.image) }}

            {% if recipe.media | length > 0 %}
                <p>image Actuelle :</p>
                <img src="{{ asset('uploads/recipesImages' ~ recipe.media.first.fileName) }}" alt="">
            {% endif %}
        </div>
        <div class="mb-3">
            <label for="inputIngredients" class="form-label">Ajouter un ingrédient: </label>
            <div id="ingredients-collection" class="collection"
                 data-prototype="{{ form_widget(form.recipeIngredients.vars.prototype)|e('html_attr') }}">
                {% for ingredient in form.recipeIngredients %}
                    <div class="ingredient">
                        <div class="ingredient-header">
                            <h4 class="ingredient-title">Ingrédient {{ loop.index }}</h4>
                            <button type="button" class="remove-ingredient">Supprimer</button>
                        </div>
                        {{ form_row(ingredient) }}
                    </div>
                {% endfor %}
                <button type="button" id="add-ingredient" class="btn btn-primary">Ajouter un ingrédient</button>
            </div>
        </div>
        <div class="mb-3">
            <label for="inputStep" class="form-label">Ajouter les étapes de la recette : </label>
            <div id="step-collection" data-prototype="{{ form_widget(form.steps.vars.prototype)|e('html_attr') }}">
                {% for step in form.steps %}
                    <div class="step">
                        <div class="step-header">
                            <h4 class="step-number">Étape {{ loop.index }}</h4>
                            <button type="button" class="remove-step">Supprimer</button>
                        </div>
                        {{ form_row(step.content) }}
                    </div>
                {% endfor %}
                <button type="button" id="add-step" class="btn btn-primary">Ajouter une étape</button>
            </div>
        </div>

        <button type="submit" class="btn w-25 btn-full-cherry">Enregistrer
        </button>
    </div>
</div>
{{ form_end(form) }}

<script>
    document.addEventListener('DOMContentLoaded', () => {
        $( '#recipe_category' ).select2( {
            theme: 'bootstrap-5',
            placeholder: 'Sélectionnez une ou plusieurs catégories',
            allowClear: true
        } );
        // Step
        const stepCollection = document.querySelector('#step-collection');
        const addStepButton = document.querySelector('#add-step');

        // add step
        addStepButton.addEventListener('click', () => {
            const index = stepCollection.querySelectorAll('.step').length; // Utiliser querySelectorAll pour un index précis
            const prototype = stepCollection.dataset.prototype.replace(/__name__/g, index);
            const div = document.createElement('div');
            div.classList.add('step');
            const stepHeader = document.createElement('div');
            stepHeader.classList.add('step-header');
            const stepNumber = document.createElement('h4');
            stepNumber.classList.add('step-number');
            stepNumber.textContent = `Étape ${index + 1}`;
            const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.classList.add('remove-step');
            removeButton.textContent = 'Supprimer';

            stepHeader.appendChild(stepNumber);
            stepHeader.appendChild(removeButton);
            div.appendChild(stepHeader);
            div.innerHTML += prototype;

            stepCollection.insertBefore(div, addStepButton);
            updateStepNumbers();
        });

        // delete steps
        stepCollection.addEventListener('click', (event) => {
            if (event.target.classList.contains('remove-step')) {
                event.target.closest('.step').remove();
                updateStepNumbers();
            }
        });

        // update step
        function updateStepNumbers() {
            const steps = stepCollection.querySelectorAll('.step');
            steps.forEach((step, index) => {
                const stepNumber = step.querySelector('.step-number');
                if (stepNumber) {
                    stepNumber.textContent = `Étape ${index + 1}`;
                }
            });
        }

        // Ingredients
        const ingredientsCollection = document.querySelector('#ingredients-collection');
        const addIngredientButton = document.querySelector('#add-ingredient');

        // add ingredient
        addIngredientButton.addEventListener('click', () => {
            const index = ingredientsCollection.querySelectorAll('.ingredient').length;
            const prototype = ingredientsCollection.dataset.prototype.replace(/__name__/g, index);
            const div = document.createElement('div');
            div.classList.add('ingredient');
            const ingredientHeader = document.createElement('div');
            ingredientHeader.classList.add('ingredient-header');
            const ingredientTitle = document.createElement('h4');
            ingredientTitle.classList.add('ingredient-title');
            ingredientTitle.textContent = `Ingrédient ${index + 1}`;
            const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.classList.add('remove-ingredient');
            removeButton.textContent = 'Supprimer';

            ingredientHeader.appendChild(ingredientTitle);
            ingredientHeader.appendChild(removeButton);
            div.appendChild(ingredientHeader);
            div.innerHTML += prototype;

            ingredientsCollection.insertBefore(div, addIngredientButton);
            updateIngredientNumbers();
        });

        // delete ingredients
        ingredientsCollection.addEventListener('click', (event) => {
            if (event.target.classList.contains('remove-ingredient')) {
                event.target.closest('.ingredient').remove();
                updateIngredientNumbers();
            }
        });

        // update ingredient num
        function updateIngredientNumbers() {
            const ingredients = ingredientsCollection.querySelectorAll('.ingredient');
            ingredients.forEach((ingredient, index) => {
                const ingredientTitle = ingredient.querySelector('.ingredient-title');
                if (ingredientTitle) {
                    ingredientTitle.textContent = `Ingrédient ${index + 1}`;
                }
            });
        }
    });
    document.addEventListener("DOMContentLoaded", function () {
        let input = document.getElementById("recipe_title");
        let preview = document.getElementById("recipeTitlePreview");
        if (!input) {
            console.error("⚠️ L'élément #recipeTitleInput n'a pas été trouvé !");
            return;
        }
        input.addEventListener("input", function () {
            preview.textContent = input.value;
        });
    });
</script>
