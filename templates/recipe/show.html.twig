{% extends 'base.html.twig' %}

{% block body %}
    <div class="container-fluid py-0 py-lg-5 px-0 px-lg-4 ">
        <!-- Recipe header -->
        <div class="row g-0 g-lg-4 mb-5">
            <!-- Images -->
            <div class="col-lg-5">
                <div class="position-relative">
                    <!-- Mobile image -->
                    <img src="https://picsum.photos/800/600" class="img-fluid rounded-0 d-block d-lg-none shadow-sm "
                         alt="Image de {{ recipes.title }}">
                    <!-- Desktop image -->
                    <img src="https://picsum.photos/800/600" class="img-fluid rounded-3 d-none d-lg-block shadow-sm "
                         alt="Image de {{ recipes.title }}">
                    <div class="position-absolute d-none d-md-block top-0 start-0 m-3">
                        {% for category in  recipes.category %}
                            <span class="badge rounded-pill bg-secondary-subtle px-3 py-2 text-black">
                                        {{ category.name }}
                                    </span>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <!-- Information -->
            <div class="col-lg-7 px-2 position-relative">
                <!-- mobile recipe header -->
                <div class="d-lg-none position-absolute bg-white rounded-top-5 start-0 end-0 pt-2" style="top: -3rem;">
                    <h1 class="display-5 fw-bold mb-3 text-center text-lg-start px-2 pt-2">{{ recipes.title }}</h1>
                    <div class="d-flex justify-content-center">
                        {% for category in  recipes.category %}
                            <span class="py-2">{{ category.name }}</span><span class="px-1 py-2 align-items-center">{% if not loop.last %}/{% endif %}</span>
                        {% endfor %}
                    </div>
                    <div class="d-flex flex-wrap gap-4 mb-4 justify-content-center justify-content-lg-start px-2">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-clock me-2 text-dark-green"></i>
                            <span>
                        {% if preparationHours > 0 %}
                            {{ preparationHours }} heure{% if preparationHours > 1 %}s{% endif %}
                            {% if preparationMinutes > 0 %}
                                {{ preparationMinutes }} minute{% if preparationMinutes > 1 %}s{% endif %}
                            {% endif %}
                        {% else %}
                            {{ preparationMinutes }} minute{% if preparationMinutes > 1 %}s{% endif %}
                        {% endif %}
                    </span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-people-fill me-2 text-dark-green"></i>
                            <span>{{ recipes.serving }} personne{% if recipes.serving > 1 %}s{% endif %}</span>
                        </div>
                    </div>
                </div>

                <!-- desktop recipe header  -->
                <div class="d-none d-lg-block">
                    <h1 class="display-5 fw-bold mb-3 text-center text-md-start">{{ recipes.title }}</h1>
                    <div class="d-flex flex-wrap gap-4 mb-4 justify-content-center justify-content-md-start">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-clock me-2 text-dark-green"></i>
                            <span>
                        {% if preparationHours > 0 %}
                            {{ preparationHours }} heure{% if preparationHours > 1 %}s{% endif %}
                            {% if preparationMinutes > 0 %}
                                {{ preparationMinutes }} minute{% if preparationMinutes > 1 %}s{% endif %}
                            {% endif %}
                        {% else %}
                            {{ preparationMinutes }} minute{% if preparationMinutes > 1 %}s{% endif %}
                        {% endif %}
                    </span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-people-fill me-2 text-dark-green"></i>
                            <span>{{ recipes.serving }} personne{% if recipes.serving > 1 %}s{% endif %}</span>
                        </div>
                    </div>
                </div>
                <div class="d-lg-none" style="margin-top: 8rem;"></div>

                <div class="bg-light-green rounded-3 mt-lg-5">
                    <p class="lead mb-0 text-center text-lg-start">{{ recipes.description }}</p>
                </div>
            </div>

        </div>

        <!-- content principal -->
        <div class="row g-0 g-lg-5 px-3">
            <!-- Ingredients -->
            <div class="col-lg-5">
                <div class="mb-4">
                    <h2 class="h3 mb-4 text-dark-brown">
                        <i class="bi bi-list-ul me-2 text-dark-green"></i>Ingrédients
                    </h2>
                </div>

                <div class="bg-light rounded-3 p-4">
                    <ul class="list-unstyled mb-0">
                        {% for recipeIngredient in recipeIngredients %}
                            <li class="d-flex justify-content-between align-items-center py-2 {% if not loop.last %}border-bottom{% endif %}">
                                <span class="fw-medium">{{ recipeIngredient.ingredient.name }}</span>
                                <span class="text-secondary">
                                    {{ recipeIngredient.quantity }} {{ recipeIngredient.unit.name }}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>

            <!-- Instructions -->
            <div class="col-lg-7 mt-4 mt-lg-0">
                <div class="mb-4">
                    <h2 class="h3 mb-4 text-dark-brown">
                        <i class="bi bi-journal-text me-2 text-dark-green"></i>
                        Instructions
                    </h2>
                </div>

                <div class="steps-timeline">
                    {% for step in recipes.steps %}
                        <div class="step-item mb-5">
                            <div class="d-flex">
                                <div class="bg-dark-green text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width: 40px; height: 40px;">
                                    <span class="fw-bold">{{ step.stepNumber }}</span>
                                </div>
                                <div class="ms-4">
                                    <h3 class="h5 mb-3">Étape {{ step.stepNumber }}</h3>
                                    <p class="mb-0">{{ step.content }}</p>
                                </div>
                            </div>
                            {% if not loop.last %}
                                <div class="ps-5 pt-2">
                                    <div class="border-start border-2 border-green ms-3 ps-4 py-2 opacity-0"></div>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
    <div class="container-fluid py-4 bg-light rounded-3 mt-5">
        <div class="row">
            <div class="col-12 mb-4">
                <h2 class="h3">
                    <i class="bi bi-chat-left-text me-2 text-dark-green"></i>Commentaires
                </h2>
            </div>

            {% if comments|length > 0 %}
                <div class="col-12 mb-4">
                    {% for comment in comments %}
                        <div class="card border-0 shadow-sm mb-3">
                            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                                <div class="d-flex align-items-center">
                                    <span class="fw-medium">{{ comment.user.username }}</span>
                                </div>
                                <small class="text-muted">{{ comment.createdAt|date("d/m/Y à H:i") }}</small>
                            </div>
                            <div class="card-body">
                                <p class="card-text mb-0">{{ comment.content }}</p>
                            </div>
                            {% if app.user and (app.user == comment.user) %}
                                <div class="card-footer bg-white text-end border-0 py-2">
                                    <a href="{{ path('app_comment_edit', {'id': comment.id}) }}" class="btn btn-sm btn-outline-secondary me-2">
                                        <i class="bi bi-pencil-square me-1"></i>Modifier
                                    </a>
                                    <a href="{{ path('app_comment_delete', {'id': comment.id}) }}" class="btn btn-sm btn-outline-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce commentaire?')">
                                        <i class="bi bi-trash me-1"></i>Supprimer
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="col-12 mb-4 text-center">
                    <div class="py-4">
                        <i class="bi bi-chat-square-text text-secondary" style="font-size: 2rem;"></i>
                        <p class="mt-3 text-secondary">Aucun commentaire pour cette recette.</p>
                    </div>
                </div>
            {% endif %}

            {% if app.user %}
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white">
                            <h3 class="h5 mb-0">
                                <i class="bi bi-pencil me-2 text-dark-green"></i>Ajouter un commentaire
                            </h3>
                        </div>
                        <div class="card-body">
                            {{ form_start(commentForm) }}
                            <div class="mb-3">
                                {{ form_widget(commentForm.content, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Partagez votre avis sur cette recette...'}}) }}
                                {{ form_errors(commentForm.content) }}
                            </div>
                            <div class="text-end">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-send me-1"></i>Publier
                                </button>
                            </div>
                            {{ form_end(commentForm) }}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-3">
                    <p class="mb-2">Connectez-vous pour laisser un commentaire</p>
                    <a href="{{ path('app_login') }}" class="btn btn-outline-success">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Connexion
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}