{% extends 'base.html.twig' %}

{% block body %}
    <div class="category-header mt-5">
        <div class="container">
            <div class="text-center d-flex gap-4 align-items-end mb-3">
                <h1 class="mb-0">{{ category|capitalize }}</h1>
                <div class="d-flex gap-2 fw-bold fs-5">
                    <div>{{ recipes|length }}</div>
                    <div>Résultat(s)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="container mb-5">
        <div class="recipe-grid">
            {{ render(path('app_include_recipe_category', {
                'category' : currentCategory.name,
            })) }}
        </div>
    </div>
{% endblock %}