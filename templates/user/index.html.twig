{% extends 'base.html.twig' %}
{% block body %}
    <div class="container">
        <!-- Profile nav -->
        <div class="row mt-5 mx-5">
            <!-- Sidebar - Profile navigation -->
            <div class="col-3 position-fixed">
                <div class="position-sticky" style="top: 2rem;">
                    <div class="d-grid mb-4">
                        <a href="{{ path('app_new_recipe') }}" class="btn btn-success rounded-pill py-2 px-4 shadow-sm">
                            <i class="bi bi-plus-circle me-2"></i>
                            Ajouter une recette
                        </a>
                    </div>

                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-success text-white py-3">
                            <h5 class="mb-0 fw-bold"><i class="bi bi-person-circle me-2"></i>Mon profil</h5>
                        </div>
                        <div class="list-group list-group-flush">
                            <a href="#bio" class="list-group-item list-group-item-action border-0 py-3">
                                <i class="bi bi-info-circle me-2"></i>Ma biographie
                            </a>
                            <a href="#myRecipe" class="list-group-item list-group-item-action border-0 py-3">
                                <i class="bi bi-journal-richtext me-2"></i>Mes recettes
                            </a>
                            <a href="#otherComment" class="list-group-item list-group-item-action border-0 py-3">
                                <i class="bi bi-chat-left-text me-2"></i>Les commentaires
                            </a>
                            <a href="#myComment" class="list-group-item list-group-item-action border-0 py-3">
                                <i class="bi bi-chat-right-quote me-2"></i>Mes commentaires
                            </a>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-secondary text-white py-3">
                            <h5 class="mb-0 fw-bold"><i class="bi bi-gear me-2"></i>Mes paramètres</h5>
                        </div>
                        <div class="list-group list-group-flush">
                            <a href="#" class="list-group-item list-group-item-action border-0 py-3">
                                <i class="bi bi-shield-lock me-2"></i>Sécurité
                            </a>
                            <a href="#" class="list-group-item list-group-item-action border-0 py-3">
                                <i class="bi bi-person-vcard me-2"></i>Informations personnelles
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="row mt-5 mx-5 justify-content-end">
            <!-- Informations -->
            <div class="col-9">
                <div class="row">
                    <!-- User presentation -->
                    <div class="col-12 mb-5" id="bio">
                        <h2>Ma biographie</h2>
                        {% include 'user/_presentation.html.twig' with {'user':user} %}
                    </div>
                    <!-- User recipes -->
                    <div class="col-12" id="myRecipe">
                        <h2>Mes recettes</h2>
                        <table class="table">
                            <thead>
                            <tr>
                                <th>Image</th>
                                <th>Titre</th>
                                <th>Type</th>
                                <th>Services</th>
                                <th>Commentaires</th>
                                <th>Temps</th>
                                <th>Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for recipe in recipes %}
                                <tr>
                                    <td><img src="https://picsum.photos/50/50" alt=""></td>
                                    <td>{{ recipe.title }}</td>
                                    <td>{{ recipe.category.name ?? 'Aucune catégorie' }}</td>
                                    <td>{{ recipe.serving }}</td>
                                    <td>{{ recipe.comments | length }}</td>
                                    <td>
                                        {% set hours = recipe.preparationTime ? (recipe.preparationTime | date('H') | number_format) : 0 %}
                                        {% set minutes = recipe.preparationTime ? (recipe.preparationTime | date('i') | number_format) : 0 %}
                                        {% if hours | number_format > 0 %}
                                            {{ hours }} heure{% if hours > 1 %}s{% endif %}
                                            {% if minutes | number_format > 0 %}
                                                et {{ minutes }} minute{% if minutes > 1 %}s{% endif %}
                                            {% endif %}
                                        {% else %}
                                            {{ minutes }} minute{% if minutes > 1 %}s{% endif %}
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ path('app_recipe_edit', {'slug' : recipe.slug}) }}" type="button"
                                           class="btn btn-full-green text-white rounded-pill py-2 px-4 shadow-sm text-nowrap">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <!-- User recipes -->
                    <div class="col-12" id="otherComment">
                        <h2>Les commentaires de mes recettes</h2>
                        <table class="table">
                            <thead>
                            <tr>
                                <th>
                                    Recette associé
                                </th>
                                <th>
                                    Contenue
                                </th>
                                <th>Auteur</th>
                                <th>
                                    Actions
                                </th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for recipe in recipes %}
                                {% for comment in recipe.comments %}
                                    <tr>
                                        <td>{{ recipe.title }}</td>
                                        <td>{{ comment.content }}</td>
                                        <td>{{ comment.author.username ?? 'Anonyme' }}</td>
                                        <td>
                                            <a href="#" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div id="myComment">
                        <h2>Mes commentaires</h2>
                        <table class="table">
                            <thead>
                            <tr>
                                <th></th>
                            </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}